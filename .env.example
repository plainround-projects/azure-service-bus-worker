# Copy to .env (git-ignored). Every value is an address or a name; none is a secret, and there is no connection string:
# the programs authenticate with DefaultAzureCredential (your `az login` session on a laptop, the managed identity in Azure).

# The namespace host name: the Terraform output servicebus_namespace (eval "$(scripts/env.sh)" exports it).
SB_NAMESPACE=sb-orders-00000.servicebus.windows.net

# Leave empty to use the queue that matches USE_SESSIONS: orders, or orders-sessions when USE_SESSIONS=1.
SB_QUEUE=
USE_SESSIONS=0

# Only in Azure: the client id of the worker's user-assigned identity. Leave empty on a laptop.
AZURE_CLIENT_ID=

# The ledger (SQLite) and the SQL scripts it is created from.
LEDGER_PATH=data/orders.db
SQL_DIR=sql

# Lesson steps 1 to 3: naive writes the row only; idempotent also records the message id in the same transaction.
MODE=idempotent
# Automatic lock renewal in seconds; 0 is off (step 2 runs with 0, step 3 with 300).
LOCK_RENEWAL_SECONDS=0
# Chaos for step 2: the first delivery of every Nth sequence number sleeps SLOW_SECONDS. 0 is off.
SLOW_EVERY=0
SLOW_SECONDS=45

MAX_WAIT_SECONDS=10
# Set a port to serve /live and /ready (the container app sets 8080).
HEALTH_PORT=
LOG_LEVEL=INFO
